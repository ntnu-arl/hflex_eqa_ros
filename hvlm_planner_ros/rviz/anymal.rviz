Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Sensors1
        - /Sensors1/Color1/Topic1
        - /TF1/Frames1
        - /Mimosa1/Path1
        - /Mimosa1/Odometry1/Shape1
        - /Mimosa1/FastOdometry1/Shape1
      Splitter Ratio: 0.5
    Tree Height: 965
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
  - Class: hvlm_ui/EQAPanel
    Name: EQAPanel
